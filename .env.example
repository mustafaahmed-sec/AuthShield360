# Copy to .env and fill in values locally. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
AUTHSHIELD_BASELINE_LOGIN=true
AUTHSHIELD_LOCKOUT_ATTEMPTS=5
AUTHSHIELD_LOCKOUT_WINDOW_MINUTES=15
# Repeat lockouts within 24 hours escalate to 15 minutes and then 30 minutes.
AUTHSHIELD_LOCKOUT_MINUTES=5
AUTHSHIELD_IP_FAILURE_LIMIT=30
AUTHSHIELD_IP_WINDOW_MINUTES=15
AUTHSHIELD_IP_THROTTLE_MINUTES=1
AUTHSHIELD_OTP_ENABLED=false
AUTHSHIELD_EMAIL_STEP_UP=false
AUTHSHIELD_OTP_TTL_SECONDS=600
# Firebase SMS challenge expires in five minutes in the portal session.
AUTHSHIELD_SMS_OTP_TTL_SECONDS=300
AUTHSHIELD_SMS_OTP_ACCOUNT_WINDOW_MINUTES=15
# Sign-in codes use a five-minute resend cooldown, then lock sending for 30 minutes after three sends.
AUTHSHIELD_OTP_RESEND_COOLDOWN_SECONDS=300
AUTHSHIELD_OTP_MAX_SENDS=3
AUTHSHIELD_OTP_SEND_LOCKOUT_MINUTES=30
AUTHSHIELD_EMAIL_OTP_TTL_SECONDS=300
# Password-reset codes expire after five minutes; replacement codes use the same cooldown.
AUTHSHIELD_PASSWORD_RESET_OTP_TTL_SECONDS=300
# Recovery requests are limited to 30 per observed IP in 15 minutes.
AUTHSHIELD_PASSWORD_RESET_IP_LIMIT=30
AUTHSHIELD_PASSWORD_RESET_IP_WINDOW_MINUTES=15
# Keep valid recovery submissions on a similar response-time floor (SMTP timeout is 8 seconds).
AUTHSHIELD_PASSWORD_RESET_RESPONSE_FLOOR_SECONDS=9
# Gmail email OTP uses a Gmail App Password. Keep it private and server-side.
AUTHSHIELD_GMAIL_ADDRESS=authshield360.team@gmail.com
AUTHSHIELD_GMAIL_APP_PASSWORD=
# Firebase Web app settings (public project configuration, not a service-account key).
# Firebase Phone Auth SMS requires a billing account and is charged per SMS.
AUTHSHIELD_FIREBASE_API_KEY=
AUTHSHIELD_FIREBASE_AUTH_DOMAIN=
AUTHSHIELD_FIREBASE_PROJECT_ID=
AUTHSHIELD_FIREBASE_APP_ID=
# Optional Keycloak OIDC sign-in. Keep disabled until the Keycloak server and
# confidential web client are configured; never commit the client secret.
AUTHSHIELD_KEYCLOAK_ENABLED=false
AUTHSHIELD_KEYCLOAK_SERVER_URL=
AUTHSHIELD_KEYCLOAK_REALM=authshield
AUTHSHIELD_KEYCLOAK_CLIENT_ID=authshield-portal
AUTHSHIELD_KEYCLOAK_CLIENT_SECRET=
# Optional dedicated service account for administrator account actions.
# Give it only the realm-level permissions the portal needs (manage-users).
AUTHSHIELD_KEYCLOAK_ADMIN_CLIENT_ID=authshield-admin-api
AUTHSHIELD_KEYCLOAK_ADMIN_CLIENT_SECRET=
DB_NAME=authshield360
DB_USER=authshield_app
DB_PASSWORD=replace-with-the-password-you-set-in-pgadmin
DB_HOST=127.0.0.1
DB_PORT=5432
DEMO_STUDENT_PASSWORD=replace-with-a-unique-random-demo-password
DEMO_TEACHER_PASSWORD=replace-with-a-unique-random-demo-password
DEMO_ADMIN_PASSWORD=replace-with-a-unique-random-demo-password
